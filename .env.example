# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Data stores
DATABASE_URL=postgres://metric_wave:metric_wave@postgres:5432/metric_wave
REDIS_URL=redis://redis:6379/0

# Tuning
METRIC_CACHE_TTL=30
INGEST_MAX_BATCH=1000
LOG_LEVEL=INFO

# Postgres container
POSTGRES_DB=metric_wave
POSTGRES_USER=metric_wave
POSTGRES_PASSWORD=metric_wave
CSRF_TRUSTED_ORIGINS=
